{
  "name": "creative-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:accessibility": "vitest run --config vitest.accessibility.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:all": "node scripts/test-runner.js",
    "test:ci": "node scripts/test-runner.js --coverage --bail",
    "test:comprehensive": "node scripts/test-runner.js --parallel --coverage --verbose",
    "test:unit:only": "node scripts/test-runner.js unit",
    "test:integration:only": "node scripts/test-runner.js integration",
    "test:e2e:only": "node scripts/test-runner.js e2e",
    "test:performance:only": "node scripts/test-runner.js performance",
    "test:accessibility:only": "node scripts/test-runner.js accessibility",
    "test:visual:only": "node scripts/test-runner.js visual",
    "test:quick": "node scripts/test-runner.js unit integration --parallel",
    "test:quality-gates": "node scripts/test-runner.js --coverage && node -e \"require('./scripts/test-runner.js').checkQualityGates()\"",
    "test:watch:all": "concurrently \"npm run test:watch\" \"npm run test:e2e -- --headed\"",
    "test:debug": "vitest --inspect-brk --no-coverage",
    "test:security": "npm audit --audit-level moderate && npx audit-ci --moderate",
    "db:setup:test": "echo 'Setup test database'",
    "coverage:open": "open coverage/index.html"
  },
  "dependencies": {
    "@next-auth/supabase-adapter": "^0.2.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.561.0",
    "next": "^16.0.10",
    "next-auth": "^4.24.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^14.3.8",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "jsdom": "^27.3.0",
    "msw": "^2.12.4",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "vitest-axe": "^0.1.0"
  }
}
